# Supabase Configuration
# Get these from your Supabase Dashboard > Settings > API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# Client-side (Vite) - same values, prefixed with VITE_
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Optional: For server-side operations requiring service role
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# (SUPABASE_SECRET_KEY is accepted as a legacy alias)

# Optional: Protects scheduled/cron endpoints (Bearer token in the request)
# CRON_SECRET="generate-a-long-random-string"
# CRON_SECRET_PREVIOUS="previous-secret-during-rotation"
